{
  "description": "JobPortal 실습용 패치 검사 예제",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/secret_guard.py",
            "timeout": 10,
            "statusMessage": "패치의 비밀값 확인"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/line_limit.py",
            "timeout": 10,
            "statusMessage": "Python 파일 길이 확인"
          }
        ]
      }
    ]
  }
}
